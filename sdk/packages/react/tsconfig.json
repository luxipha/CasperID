{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationMap": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "paths": {
            "react": [
                "../../../frontend/node_modules/@types/react"
            ],
            "framer-motion": [
                "../../../frontend/node_modules/framer-motion"
            ],
            "lucide-react": [
                "../../../frontend/node_modules/lucide-react"
            ]
        },
        "typeRoots": [
            "../../../frontend/node_modules/@types"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}