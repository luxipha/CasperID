{
    "name": "@casperid/react",
    "version": "1.0.2",
    "description": "CasperID Identity SDK — embeddable React modal for authentication and KYC verification",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "type": "module",
    "keywords": [
        "casper",
        "identity",
        "verification",
        "blockchain",
        "did",
        "passkey",
        "zkp",
        "privacy",
        "react",
        "sdk",
        "auth"
    ],
    "files": [
        "dist"
    ],
    "author": "CasperID Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/luxipha/CasperID-sdk.git"
    },
    "bugs": {
        "url": "https://github.com/luxipha/CasperID-sdk/issues"
    },
    "homepage": "https://casperid.com",
    "scripts": {
        "dev": "vite --port=3001",
        "build": "tsc --noEmit && vite build",
        "lint": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18",
        "framer-motion": ">=10"
    },
    "dependencies": {
        "lucide-react": "^0.400.0",
        "@mediapipe/face_mesh": "^0.4.1633559619",
        "@mediapipe/camera_utils": "^0.3.1620248257"
    },
    "devDependencies": {
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "typescript": "~5.8.2",
        "vite": "^6.2.0",
        "@vitejs/plugin-react": "^5.0.0",
        "@tailwindcss/vite": "^4.1.0",
        "tailwindcss": "^4.1.0"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            }
        },
        "./style.css": "./dist/style.css"
    },
    "sideEffects": [
        "*.css"
    ]
}