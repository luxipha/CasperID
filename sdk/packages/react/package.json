{
    "name": "@casperid/react",
    "version": "2.0.1",
    "description": "Lightweight React SDK for CasperID hosted authorization",
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "type": "module",
    "keywords": [
        "casper",
        "identity",
        "verification",
        "blockchain",
        "did",
        "passkey",
        "zkp",
        "privacy",
        "react",
        "sdk",
        "auth"
    ],
    "files": [
        "dist"
    ],
    "author": "CasperID Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/luxipha/CasperID-sdk.git"
    },
    "bugs": {
        "url": "https://github.com/luxipha/CasperID-sdk/issues"
    },
    "homepage": "https://casperid.com",
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "vite --port=3001",
        "build": "tsc --noEmit && vite build",
        "lint": "tsc --noEmit",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "dependencies": {},
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^18",
        "@types/react-dom": "^18",
        "@vitejs/plugin-react": "^5.0.0",
        "jsdom": "^29.1.1",
        "tailwindcss": "^4.1.0",
        "typescript": "~5.8.2",
        "vite": "^6.2.0",
        "vitest": "^4.1.6"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            }
        }
    }
}
