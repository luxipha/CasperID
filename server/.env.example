# CasperID Server Environment Configuration
# Copy this file to .env and update the values for your environment

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# DATABASE
# ============================================
# MongoDB Atlas (Cloud Database)
MONGODB_URI=mongodb://localhost:27017/casperid

# ============================================
# JWT CONFIGURATION
# ============================================
# Generate a strong 64-character random hex string for production
JWT_SECRET=test-secret-key-change-in-production

# ============================================
# WEBAUTHN CONFIGURATION
# ============================================
# Production: keep this permanently set to casperid.com. WebAuthn may run on
# account.casperid.com because casperid.com is its registrable domain suffix.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=CasperID
# Comma-separated exact origins accepted in WebAuthn responses.
# Production example:
# WEBAUTHN_ORIGIN=https://account.casperid.com,https://casperid.com
WEBAUTHN_ORIGIN=http://localhost:3000
# Challenge timeout in milliseconds
WEBAUTHN_CHALLENGE_TIMEOUT=60000

# ============================================
# APPLICATION URLS
# ============================================
# Frontend URL for CORS and redirects
FRONTEND_URL=http://localhost:3000
# Hosted passkey authorization origin. Affiliates redirect here before WebAuthn.
ACCOUNT_FRONTEND_URL=http://localhost:3000
# Backend API base URL
API_BASE_URL=http://localhost:3001

# ============================================
# EMAIL SERVICE (HYBRID SYSTEM)
# ============================================
# Choose primary provider: 'loops' or 'smtp'
EMAIL_PROVIDER=smtp

# SMTP Configuration (Used for OTPs and as fallback)
# Compatible with Gmail, Brevo, SendGrid, or any custom SMTP
SMTP_HOST=mail.ile.africa
SMTP_PORT=587
SMTP_USER=support@ile.africa
SMTP_PASS=your-smtp-password
EMAIL_FROM="CasperID" <support@ile.africa>

# Loops.so Configuration (For Marketing & Lifecycle)
LOOPS_API_KEY=your-loops-api-key
LOOPS_WELCOME_ID=
LOOPS_VERIFICATION_SUCCESS_ID=
LOOPS_PROFILE_VIEWED_ID=
LOOPS_PROFILE_COMPLETED_ID=
LOOPS_PAYMENT_CONFIRMATION_ID=
LOOPS_SECURITY_ALERT_ID=


# ============================================
# CASPER BLOCKCHAIN
# ============================================
# Casper network configuration
CASPER_NETWORK_URL=https://rpc.casper.network
CASPER_CHAIN_NAME=casper-mainnet

# Issuer keys for credential signing
ISSUER_PRIVATE_KEY=your-casper-private-key-hex
ISSUER_PUBLIC_KEY=your-casper-public-key-hex

# ============================================
# EXTERNAL SERVICES (AI & IMAGE STORAGE)
# ============================================
GOOGLE_API_KEY=your-google-ai-api-key
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Session configuration
SESSION_SECRET=change-this-session-secret-in-production
COOKIE_DOMAIN=localhost

# Rate limiting
ENABLE_RATE_LIMITING=true

# Admin account (for initial setup only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# ============================================
# METAMASK ADVANCED PERMISSIONS
# ============================================
# Supported EIP-7702 networks (comma-separated chain IDs)
SUPPORTED_CHAIN_IDS=1,11155111,8453,84532

# Default verification pricing
LAYER_2_VERIFICATION_COST=5
LAYER_3_VERIFICATION_COST=10
VERIFICATION_CURRENCY=USDC

# ============================================
# BLOCKCHAIN EVENT INDEXING
# ============================================
# RPC endpoints for blockchain event indexing
ETHEREUM_RPC_URL=https://eth.llamarpc.com
SEPOLIA_RPC_URL=https://rpc.sepolia.org
BASE_RPC_URL=https://base.llamarpc.com

# Bridge contract addresses for each network
ETH_CASPER_BRIDGE_ADDRESS=
SEPOLIA_CASPER_BRIDGE_ADDRESS=
BASE_CASPER_BRIDGE_ADDRESS=

# Indexer configuration
INDEXER_AUTO_START=false
INDEXER_POLL_INTERVAL=15000
INDEXER_BLOCK_BATCH_SIZE=1000
