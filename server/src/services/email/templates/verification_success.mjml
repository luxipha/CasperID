<mjml>
  <mj-head>
    <mj-title>Verification Successful - CasperID</mj-title>
    <mj-font name="Plus Jakarta Sans" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&display=swap" />
    <mj-attributes>
      <mj-all font-family="Plus Jakarta Sans, Inter, Arial, sans-serif" />
      <mj-text font-size="16px" color="#626D85" line-height="1.6" />
      <mj-button background-color="#8652E2" color="white" border-radius="12px" font-weight="800" font-size="16px" inner-padding="16px 32px" />
    </mj-attributes>
    <mj-style>
      .logo-text { font-weight: 800; font-size: 24px; color: #1A1A2E; }
      .hero-title { font-size: 32px; font-weight: 800; color: #1A1A2E; }
      .tier-badge { 
        display: inline-block; 
        padding: 4px 12px; 
        border-radius: 999px; 
        font-size: 12px; 
        font-weight: 800; 
        text-transform: uppercase; 
        letter-spacing: 1px;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F8F9FF">
    
    <!-- Header -->
    <mj-section padding="40px 20px 30px">
      <mj-column>
        <mj-image src="https://www.casperid.com/logos/logo.png" width="48px" align="center" padding-bottom="12px" />
        <mj-text align="center" padding-top="0">
          <span style="font-weight: 800; font-size: 24px; color: #1A1A2E;">Casper<span style="color: #9333EA;">ID</span></span><br />
          <span style="font-size: 12px; color: #626D85; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Verify once. Reuse everywhere.</span>
        </mj-text>      </mj-column>
    </mj-section>
    
    <!-- Main Card -->
    <mj-section padding="0 20px 40px">
      <mj-column background-color="#ffffff" border-radius="24px" padding="50px 40px" border="1px solid #E5E7EB">
        
        <mj-text align="center" padding-bottom="10px">
          <span style="color: #059669; font-size: 48px;">✓</span>
        </mj-text>
        
        <mj-text align="center" padding-bottom="20px">
          <span class="hero-title">Verification Successful!</span>
        </mj-text>
        
        <mj-text align="center" padding-bottom="30px">
          Congratulations, {DATA_VARIABLE:recipientName}! Your identity has been successfully verified. You have now reached:
        </mj-text>

        <mj-text align="center" padding-bottom="30px">
          <span style="background-color: #ECFDF5; color: #059669; padding: 8px 24px; border-radius: 12px; font-weight: 800; font-size: 18px;">
            {DATA_VARIABLE:tierLabel}
          </span>
        </mj-text>

        <mj-text padding-bottom="20px">
          Your CasperID is now active and ready to work for you. With this status, you can instantly log into partner platforms without ever filling out a KYC form again.
        </mj-text>

        <mj-text padding-bottom="30px">
          Even better: you are now eligible to earn rewards. Every time a business pings your CasperID to verify your identity, you'll earn a direct cut of the verification fee.
        </mj-text>
        
        <mj-button href="{DATA_VARIABLE:frontendUrl}/profile">
          View Your Verified Profile
        </mj-button>
        
        <mj-spacer height="40px" />
        
        <mj-divider border-width="1px" border-color="#F3F4F6" />
        
        <mj-text font-size="14px" font-weight="700" color="#1A1A2E" text-transform="uppercase" letter-spacing="1px" padding-top="30px">
          What happens next?
        </mj-text>

        <mj-text padding-top="10px">
          • <strong>Skip KYC Forever:</strong> Log into partner platforms instantly—no more forms.<br/>
          • <strong>Earn Passively:</strong> Get paid every time your identity is verified.<br/>
          • <strong>Stay in Control:</strong> You decide who can access your data, and when.
        </mj-text>
        
      </mj-column>
    </mj-section>
    
    <!-- Footer -->
    <mj-section padding="0 20px 40px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9CA3AF">
          This is an automated notification from CasperID Protocol regarding your account status.<br/>
          © 2026 CasperID Protocol. Secure. Private. Yours.
        </mj-text>
      </mj-column>
    </mj-section>
    
  </mj-body>
</mjml>
