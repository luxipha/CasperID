<mjml>
  <mj-head>
    <mj-title>You're all set - CasperID</mj-title>
    <mj-font name="Plus Jakarta Sans" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&display=swap" />
    <mj-attributes>
      <mj-all font-family="Plus Jakarta Sans, Inter, Arial, sans-serif" />
      <mj-text font-size="16px" color="#626D85" line-height="1.6" />
      <mj-button background-color="#8652E2" color="white" border-radius="12px" font-weight="800" font-size="16px" inner-padding="16px 32px" />
    </mj-attributes>
    <mj-style>
      .logo-text { font-weight: 800; font-size: 24px; color: #1A1A2E; }
      .hero-title { font-size: 28px; font-weight: 800; color: #1A1A2E; }
      .receipt-label { color: #9CA3AF; font-size: 12px; font-weight: 700; text-transform: uppercase; margin-bottom: 4px; }
      .receipt-value { color: #1A1A2E; font-size: 16px; font-weight: 600; margin-bottom: 16px; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F8F9FF">
    
    <!-- Header -->
    <mj-section padding="40px 20px 30px">
      <mj-column>
        <mj-image src="https://www.casperid.com/logos/logo.png" width="48px" align="center" padding-bottom="12px" />
        <mj-text align="center" padding-top="0">
          <span style="font-weight: 800; font-size: 24px; color: #1A1A2E;">Casper<span style="color: #9333EA;">ID</span></span><br />
          <span style="font-size: 12px; color: #626D85; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">Verify once. Reuse everywhere.</span>
        </mj-text>      </mj-column>
    </mj-section>
    
    <!-- Main Card -->
    <mj-section padding="0 20px 40px">
      <mj-column background-color="#ffffff" border-radius="24px" padding="50px 40px" border="1px solid #E5E7EB">
        
        <mj-text align="center" padding-bottom="10px">
          <span style="color: #10B981; font-size: 48px;">✓</span>
        </mj-text>
        
        <mj-text align="center" padding-bottom="30px">
          <span class="hero-title">You're all set</span>
        </mj-text>

        <mj-text align="center" padding-bottom="40px">
          {DATA_VARIABLE:recipientName}, your payment went through. Here's your receipt.
        </mj-text>
        
        <!-- Receipt Details -->
        <mj-section background-color="#F9FAF1" border-radius="16px" padding="24px">
          <mj-column>
            <mj-text>
              <div class="receipt-label">Amount Paid</div>
              <div class="receipt-value" style="font-size: 24px; color: #8652E2;">{DATA_VARIABLE:amount} {DATA_VARIABLE:currency}</div>
              
              <div class="receipt-label">Items / Service</div>
              <div class="receipt-value">{DATA_VARIABLE:items}</div>
              
              <div class="receipt-label">Transaction ID</div>
              <div class="receipt-value" style="font-family: monospace; font-size: 12px; word-break: break-all;">{DATA_VARIABLE:transactionId}</div>
            </mj-text>
          </mj-column>
        </mj-section>
        
        <mj-spacer height="40px" />
        
        <mj-button href="{DATA_VARIABLE:frontendUrl}/dashboard">
          Go to Dashboard
        </mj-button>

        <mj-spacer height="32px" />

        <mj-text align="center" font-size="14px">
          Questions about this charge? Just reply to this email — we're here to help.
        </mj-text>
        
      </mj-column>
    </mj-section>
    
    <!-- Footer -->
    <mj-section padding="0 20px 40px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9CA3AF">
          This is your official receipt from CasperID. Keep it somewhere safe.<br/>
          © 2026 CasperID Protocol. Secure. Private. Yours.
        </mj-text>
      </mj-column>
    </mj-section>
    
  </mj-body>
</mjml>
