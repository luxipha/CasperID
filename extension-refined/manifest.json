{
    "manifest_version": 3,
    "name": "CasperID Connect",
    "version": "1.0.0",
    "description": "Sign in to websites with your verified CasperID",
    "permissions": [
        "storage",
        "activeTab",
        "notifications"
    ],
    "host_permissions": [
        "http://localhost:3000/*",
        "http://localhost:3001/*"
    ],
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "assets/*",
                "icons/*",
                "logo.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    }
}